              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 400\", () => pm.response.to.have.status(400));",
                  "",
                  "pm.test(\"reports each missing field\", () => {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body).to.have.property(\"start\").that.is.an(\"array\");",
                  "    pm.expect(body).to.have.property(\"finish\").that.is.an(\"array\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
